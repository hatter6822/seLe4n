# RPi5 boot map: the Lean memory map per RAM configuration (every variant, and firmware-cut ones), and its kind at every probe (Lean/Rust cross-check)
kernelReserved 0x0 0x10000000
physicalAddressWidth 0x28
declaredCores 0x4
mmio uart 0x107d001000 0x200
mmio gicd 0x107fff9000 0x1000
mmio gicc 0x107fffa000 0x2000
variant 0x40000000 lowRamTop 0x40000000
region 0x0 0x40000000 ram
region 0x107c000000 0x4000000 device
extend 0x10000000 0x30000000
probe 0x0 ram
probe 0x3fffffff ram
probe 0x40000000 reserved
probe 0x107bffffff reserved
probe 0x107c000000 device
probe 0x107fffffff device
probe 0x1080000000 reserved
probe 0x4000000000 reserved
