# RPi5 boot map: the Lean memory map per RAM variant, and its kind at every probe (Lean/Rust cross-check)
kernelReserved 0x0 0x10000000
mmio uart 0x107d001000 0x1000
mmio gicd 0x107fff9000 0x1000
mmio gicc 0x107fffa000 0x2000
variant 0x40000000 ramTop 0x40000000
region 0x0 0x40000000 ram
region 0x107c000000 0x4000000 device
probe 0x0 ram
probe 0x3fffffff ram
probe 0x40000000 reserved
probe 0x107bffffff reserved
probe 0x107c000000 device
probe 0x107fffffff device
probe 0x1080000000 reserved
probe 0x4000000000 reserved
variant 0x80000000 ramTop 0x80000000
region 0x0 0x80000000 ram
region 0x107c000000 0x4000000 device
extend 0x40000000 0x40000000
probe 0x0 ram
probe 0x7fffffff ram
probe 0x80000000 reserved
probe 0x107bffffff reserved
probe 0x107c000000 device
probe 0x107fffffff device
probe 0x1080000000 reserved
probe 0x4000000000 reserved
variant 0x100000000 ramTop 0x100000000
region 0x0 0x100000000 ram
region 0x107c000000 0x4000000 device
extend 0x40000000 0xc0000000
probe 0x0 ram
probe 0xffffffff ram
probe 0x100000000 reserved
probe 0x107bffffff reserved
probe 0x107c000000 device
probe 0x107fffffff device
probe 0x1080000000 reserved
probe 0x4000000000 reserved
variant 0x200000000 ramTop 0x200000000
region 0x0 0x200000000 ram
region 0x107c000000 0x4000000 device
extend 0x40000000 0x1c0000000
probe 0x0 ram
probe 0x1ffffffff ram
probe 0x200000000 reserved
probe 0x107bffffff reserved
probe 0x107c000000 device
probe 0x107fffffff device
probe 0x1080000000 reserved
probe 0x4000000000 reserved
variant 0x400000000 ramTop 0x400000000
region 0x0 0x400000000 ram
region 0x107c000000 0x4000000 device
extend 0x40000000 0x3c0000000
probe 0x0 ram
probe 0x3ffffffff ram
probe 0x400000000 reserved
probe 0x107bffffff reserved
probe 0x107c000000 device
probe 0x107fffffff device
probe 0x1080000000 reserved
probe 0x4000000000 reserved
